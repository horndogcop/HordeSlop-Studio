<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".HordecraftApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_robot"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_robot"
        android:supportsRtl="true"
        android:theme="@style/Theme.HordeSlopStudio"
        android:usesCleartextTraffic="false"
        tools:ignore="UnusedAttribute">

        <!-- Main Hub Activity -->
        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity="net.hordeslop.studio.task.main"
            android:windowSoftInputMode="adjustResize" />

        <!-- Exported Activities with distinct taskAffinity so users can switch via Recents or shortcuts -->
        <activity
            android:name=".ui.activities.ImageGenActivity"
            android:exported="true"
            android:label="@string/title_activity_image"
            android:launchMode="singleTask"
            android:taskAffinity="net.hordeslop.studio.task.studio"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="aihorde.net" />
                <data android:host="www.aihorde.net" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="tinybots.net" />
                <data android:host="www.tinybots.net" />
                <data android:pathPrefix="/artbot" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="aqualxx.github.io" />
                <data android:pathPrefix="/stable-ui" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="efreak.github.io" />
                <data android:pathPrefix="/stable-ui" />
            </intent-filter>
        </activity>

        <!-- Switchable Launcher Icons -->
        <activity-alias
            android:name=".LauncherRobot"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_robot"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_robot"
            android:targetActivity=".ui.activities.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherHaidra"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_haidra"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_haidra"
            android:targetActivity=".ui.activities.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity
            android:name=".ui.activities.GalleryActivity"
            android:exported="true"
            android:label="@string/title_activity_gallery"
            android:launchMode="singleTask"
            android:taskAffinity="net.hordeslop.studio.task.gallery" />

        <activity-alias
            android:name=".WallpaperGalleryPicker"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_robot"
            android:label="@string/title_wallpaper_gallery"
            android:targetActivity=".ui.activities.GalleryActivity">
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.activities.UserActivity"
            android:exported="true"
            android:label="@string/title_activity_user"
            android:launchMode="singleTask"
            android:taskAffinity="net.hordeslop.studio.task.user" />

        <activity
            android:name=".ui.activities.SettingsActivity"
            android:exported="true"
            android:label="@string/title_activity_settings"
            android:launchMode="singleTask"
            android:taskAffinity="net.hordeslop.studio.task.settings" />

        <!-- Deferred Tier 2 Exported Activities (hidden from bottom nav in MVP, accessible via shortcuts/menu) -->
        <activity
            android:name=".ui.activities.ModelsActivity"
            android:exported="true"
            android:label="@string/title_activity_models"
            android:launchMode="singleTask"
            android:taskAffinity="net.hordeslop.studio.task.models" />

        <activity
            android:name=".ui.activities.TextGenActivity"
            android:exported="true"
            android:label="@string/title_activity_text"
            android:launchMode="singleTask"
            android:taskAffinity="net.hordeslop.studio.task.text" />

        <activity
            android:name=".ui.activities.AlchemistActivity"
            android:exported="true"
            android:label="@string/title_activity_alchemist"
            android:launchMode="singleTask"
            android:taskAffinity="net.hordeslop.studio.task.alchemist" />

        <service
            android:name=".service.HordeJobService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:ignore="ForegroundServicePermission" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
